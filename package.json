{
  "name": "masterchef-staking",
  "version": "1.0.0",
  "description": "A gas-optimized, scalable staking contract using the MasterChef pattern for native token (ETH/BNB) reward distribution",
  "main": "index.js",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:coverage": "npx hardhat coverage",
