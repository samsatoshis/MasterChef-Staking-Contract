    "deploy:mainnet": "npx hardhat run scripts/deploy.js --network mainnet",
    "clean": "npx hardhat clean"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "staking",
    "masterchef",
    "defi",
    "ethereum",
    "solidity",
    "smart-contracts",
    "erc20",
    "rewards"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@openzeppelin/contracts": "^5.3.0",
    "dotenv": "^16.5.0",
    "hardhat": "^2.24.0"
  }
}
